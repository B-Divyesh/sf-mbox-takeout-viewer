# Vite content-addresses JS and CSS emitted under /assets. They can be reused
# forever; a changed file has a new URL. Keep shell documents revalidatable.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
